<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:ce="sap.ui.codeeditor">
    <Dialog 
        id="workflowDialog"
        title="Workflow Maker"
        contentWidth="90vw"
        contentHeight="90vh"
        resizable="true"
        draggable="true"
        verticalScrolling="false"
        horizontalScrolling="false">
        
        <content>
            <VBox height="100%" class="sapUiNoContentPadding">
                <IconTabBar id="idIconTabBar" select=".onTabSelect" expanded="{device>/isNoPhone}" class="sapUiNoContentPadding" stretchContentHeight="false">
                    <items>
                        <IconTabFilter text="Manager" key="manager" />
                        <IconTabFilter text="Sample Form" key="sampleFormView" />
                        <IconTabFilter text="Form To Be Sent" key="formToBeSentView" />
                        <IconTabFilter text="Query Code" key="queryCodeView" />
                    </items>
                </IconTabBar>

                <!-- Container for IFRAME using flex layout to take remaining space -->
                <!-- We must not use visible binding for managerView, otherwise UI5 will destroy the iframe causing reloads. We toggle via class. -->
                <VBox id="managerView" height="100%" width="100%" renderType="Bare">
                    <core:HTML content='&lt;iframe id="manageIframe" src="http://localhost:8000/manage" style="border:none; width:100%; height:100%; display:block;"&gt;&lt;/iframe&gt;' />
                </VBox>

                <!-- Container for Sample Form -->
                <VBox id="sampleFormBox" height="100%" width="100%" renderType="Bare" visible="{= ${appView>/selectedTab} === 'sampleFormView'}">
                    <ce:CodeEditor id="ceSampleForm" type="json" value="{appView>/sampleForm}" height="100%" width="100%" />
                </VBox>

                <!-- Container for Form To Be Sent -->
                <VBox id="formToBeSentBox" height="100%" width="100%" renderType="Bare" visible="{= ${appView>/selectedTab} === 'formToBeSentView'}">
                    <ce:CodeEditor id="ceFormToBeSent" type="json" value="{appView>/formToBeSent}" height="100%" width="100%" />
                </VBox>

                <!-- Container for Query Code -->
                <VBox id="queryCodeBox" height="100%" width="100%" renderType="Bare" visible="{= ${appView>/selectedTab} === 'queryCodeView'}">
                    <ce:CodeEditor id="ceQueryCode" type="javascript" value="{appView>/queryCode}" height="100%" width="100%" />
                </VBox>
            </VBox>
        </content>
        
        <buttons>
            <Button text="Close" press=".onCloseWorkflowDialog" />
        </buttons>
        
    </Dialog>
</core:FragmentDefinition>
