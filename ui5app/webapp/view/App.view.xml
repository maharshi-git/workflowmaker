<mvc:View
    controllerName="workflowmaker.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
    height="100%">
    <App id="app">
        <Page title="Workflow application" enableScrolling="false">
            <content>
                <VBox class="sapUiMediumMargin" alignItems="Center" justifyContent="Center" height="100%">
                    <Button text="Open Workflow Maker" type="Emphasized" press=".onOpenWorkflowDialog" />
                </VBox>
            </content>
        </Page>
    </App>
</mvc:View>
